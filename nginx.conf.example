# Nginx configuration for mini-mall.uz
# Place in /etc/nginx/sites-available/mini-mall.uz and link to sites-enabled

server {
    listen 80;
    server_name mini-mall.uz www.mini-mall.uz;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mini-mall.uz www.mini-mall.uz;

    # SSL certificates (e.g. from Let's Encrypt certbot)
    # ssl_certificate /etc/letsencrypt/live/mini-mall.uz/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mini-mall.uz/privkey.pem;

    root /var/www/mini-mall.uz/dist;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 10240;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript;
    gzip_disable "MSIE [1-6]\.";

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }

    # SPA fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
}
